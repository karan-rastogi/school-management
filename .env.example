# Copy to .env at the repository root and adjust the values.
# The backend reads this file, and docker compose uses it for variable interpolation.

# --- PostgreSQL (docker compose service) ---
POSTGRES_DB=school
POSTGRES_USER=school
POSTGRES_PASSWORD=change-me-in-real-environments
POSTGRES_PORT=5433

# --- Backend ---
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5433/school
DB_USERNAME=school
DB_PASSWORD=change-me-in-real-environments
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
APP_TIMEZONE=Asia/Kolkata
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Attendance percentage rules (bound to AttendancePolicy, all optional) ---
# A day's weight in the numerator; EXCUSED is excluded from the denominator entirely.
ATTENDANCE_PRESENT_WEIGHT=1.0
ATTENDANCE_LATE_WEIGHT=1.0
ATTENDANCE_HALF_DAY_WEIGHT=0.5
ATTENDANCE_ABSENT_WEIGHT=0.0
ATTENDANCE_EXCUSED_EXCLUDED=true
ATTENDANCE_WARNING_THRESHOLD=75.0

# --- Notice attachments (signed URLs; all optional) ---
NOTICE_SIGNED_URL_TTL=PT15M
NOTICE_MAX_ATTACHMENT_BYTES=10485760
NOTICE_ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg,image/webp,text/plain
NOTICE_STORAGE_DIR=./uploads/notice-attachments
NOTICE_SIGNING_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# --- Authentication: token signing ---
# MUST be replaced outside local development. At least 32 bytes (256 bits) for HS256.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_ISSUER=school-management
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D

# --- Authentication: session cookies ---
# `Secure` cookies are accepted by browsers on http://localhost, so this stays true in dev.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Lax
FRONTEND_BASE_URL=http://localhost:5173

# --- Authentication: sign-in method feature flags ---
# Simple email + password login, for local testing of all roles. NEVER enable in production:
# the app refuses to start if this is true with the `prod` profile.
AUTH_PASSWORD_LOGIN_ENABLED=false
# Google sign-in and phone OTP are on by default. When a flag is false its endpoints return 404.
AUTH_OAUTH_ENABLED=true
AUTH_OTP_ENABLED=true
# Password-login lockout and rate limits (only used when password login is enabled).
AUTH_PASSWORD_MAX_FAILED_ATTEMPTS=5
AUTH_PASSWORD_LOCKOUT_DURATION=PT15M
AUTH_PASSWORD_RATE_IP_ATTEMPTS=20
AUTH_PASSWORD_RATE_EMAIL_ATTEMPTS=10
AUTH_PASSWORD_RATE_WINDOW=PT15M
# Password for the seeded test accounts. Only used when password login is enabled and the
# database is empty. Leave blank to skip seeding. Never commit a real value.
SEED_TEST_PASSWORD=

# --- Google sign-in (a pre-registered, active users row is required; there is no auto-signup) ---
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret

# --- Phone OTP ---
# `console` prints the code to the application log (development only).
OTP_SENDER=console
OTP_TTL=PT5M
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RATE_PHONE_REQUESTS=3
OTP_RATE_PHONE_VERIFIES=10
OTP_RATE_IP_REQUESTS=10
OTP_RATE_IP_VERIFIES=30
OTP_RATE_WINDOW=PT15M
# Development only: print the OTP code to the log. Never enable in production.
OTP_CONSOLE_EXPOSE_CODE=false

# --- Rate limiting the OAuth sign-in entry point (per client address) ---
AUTH_RATE_OAUTH_STARTS_PER_IP=30
AUTH_RATE_WINDOW=PT15M

# --- Frontend (see frontend/.env.example) ---
VITE_API_BASE_URL=http://localhost:8080
